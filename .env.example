APP_HOST=0.0.0.0
APP_PORT=4050

# MYOB Advanced / Acumatica contract endpoint
MYOB_BASE_URL=https://prv.myobadvanced.com
MYOB_API_ROOT=/entity/CustomExt/22.200.001
MYOB_USERNAME=PRVSyncerAPI
MYOB_PASSWORD=replace-me
MYOB_COMPANY=PRV
# The current test endpoint required curl -k. Prefer true after its certificate is fixed.
MYOB_VERIFY_SSL=false
MYOB_TIMEOUT_SECONDS=45

# The syncer PostgreSQL database is published on the Ubuntu host.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=prv-syncer
DATABASE_USER=prv-syncer
DATABASE_PASSWORD=replace-me

# SATO CG412DT-LAN; discovered by MAC because its DHCP address can change.
PRINTER_NAME=sato-barcode
PRINTER_MODEL=CG412DT-LAN
PRINTER_LANGUAGE=SBPL
PRINTER_MAC=00:19:98:84:26:F9
PRINTER_PORT=9100
ARP_INTERFACE=enp5s0
PRINTER_CONNECT_TIMEOUT_SECONDS=3
# The CG4 LAN manual requires 150-200 ms between closing and reopening a port.
PRINTER_REOPEN_DELAY_MS=250
# CG4 quality controls: 2/3/4 = 50/75/100 mm/s; darkness is 1A through 5A.
PRINTER_PRINT_SPEED=2
PRINTER_DARKNESS=4A
# Optional emergency override; normally leave blank so MAC discovery is used.
PRINTER_IP_OVERRIDE=

# Keep false until a generated .sbpl spool file has been checked/tested.
PRINT_ENABLED=false
LABEL_WIDTH_MM=50
LABEL_HEIGHT_MM=30
PRINTER_DOTS_PER_MM=12

DATA_DIR=/app/data
SPOOL_DIR=/app/spool

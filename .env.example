APP_HOST=0.0.0.0
APP_PORT=4050

# MYOB Advanced / Acumatica contract endpoint
MYOB_BASE_URL=https://prv.myobadvanced.com
MYOB_API_ROOT=/entity/CustomExt/22.200.001
MYOB_USERNAME=PRVSyncerAPI
MYOB_PASSWORD=replace-me
MYOB_COMPANY=PRV
# The current test endpoint required curl -k. Prefer true after its certificate is fixed.
MYOB_VERIFY_SSL=false
MYOB_TIMEOUT_SECONDS=45

# PIN-protected MYOB barcode assignment. Writes require an explicit opt-in.
BARCODE_ADMIN_PIN=
BARCODE_ADMIN_SESSION_MINUTES=30
BARCODE_ASSIGNMENT_ENABLED=false

# The syncer PostgreSQL database is published on the Ubuntu host.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=prv-syncer
DATABASE_USER=prv-syncer
DATABASE_PASSWORD=replace-me

# SATO CG412DT-LAN; discovered by MAC because its DHCP address can change.
PRINTER_NAME=sato-barcode
PRINTER_MODEL=CG412DT-LAN
PRINTER_LANGUAGE=SBPL
PRINTER_MAC=00:19:98:84:26:F9
PRINTER_PORT=9100
ARP_INTERFACE=enp5s0
PRINTER_CONNECT_TIMEOUT_SECONDS=3
# The CG4 LAN manual requires 150-200 ms between closing and reopening a port.
PRINTER_REOPEN_DELAY_MS=250
# A large job may take time to enter the printer's small receive buffer while
# it is already printing.
PRINTER_SEND_TIMEOUT_SECONDS=180
# Retries are used only before any print bytes have been accepted. A partial
# transmission is never automatically repeated because that duplicates labels.
PRINTER_SEND_ATTEMPTS=3
PRINTER_RETRY_DELAY_MS=1000
# CG4 quality controls: 2/3/4 = 50/75/100 mm/s; darkness is 1A through 5A.
PRINTER_PRINT_SPEED=2
PRINTER_DARKNESS=4A
# Optional emergency override; normally leave blank so MAC discovery is used.
PRINTER_IP_OVERRIDE=

# Keep false until a generated .sbpl spool file has been checked/tested.
PRINT_ENABLED=false
LABEL_WIDTH_MM=50
LABEL_HEIGHT_MM=30
PRINTER_DOTS_PER_MM=12

# Zebra ZD421 with the permanent 100 x 175 mm large-label stock. It has its
# own discovery cache and is checked only when an operator opens the guarded
# large-print confirmation.
LARGE_PRINTER_NAME=zebra-large-label
LARGE_PRINTER_MODEL=ZD421
LARGE_PRINTER_LANGUAGE=ZPL
LARGE_PRINTER_MAC=60:95:32:06:E0:CF
LARGE_PRINTER_PORT=9100
LARGE_PRINTER_IP_OVERRIDE=
LARGE_PRINTER_PRINT_SPEED=2
# Zebra darkness is 0 through 30. Start at 20 and adjust after a physical test.
LARGE_PRINTER_DARKNESS=20
# Keep false until the first generated .zpl file/layout has been checked.
LARGE_PRINT_ENABLED=false
LARGE_LABEL_WIDTH_MM=100
LARGE_LABEL_HEIGHT_MM=175
# 203 dpi Zebra heads use 8 dots/mm.
LARGE_PRINTER_DOTS_PER_MM=8

DATA_DIR=/app/data
SPOOL_DIR=/app/spool
